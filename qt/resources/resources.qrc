        <file alias="themes/common.qss">themes/common.qss</file>
        <file alias="icons/close-light.svg">icons/close-light.svg</file>
        <file alias="icons/close-dark.svg">icons/close-dark.svg</file>
        <file alias="icons/arrow-up-light.svg">icons/arrow-up-light.svg</file>
        <file alias="icons/arrow-down-light.svg">icons/arrow-down-light.svg</file>
        <file alias="icons/arrow-up-dark.svg">icons/arrow-up-dark.svg</file>
        <file alias="icons/arrow-down-dark.svg">icons/arrow-down-dark.svg</file>
    </qresource>
</RCC>
