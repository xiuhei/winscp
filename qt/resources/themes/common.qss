QToolBar { border: none; border-bottom: 1px solid; spacing: 2px; padding: 4px 8px; }
QToolBar::separator { width: 1px; margin: 4px 5px; }
QToolButton { border: 1px solid transparent; border-radius: 4px; padding: 3px; }
QToolButton#AutoRefreshButton { padding: 2px 7px; }
QPushButton { border: 1px solid; border-radius: 4px; min-height: 24px; padding: 2px 14px; }
QPushButton:default { border: 1px solid; }
QMenuBar { border: none; }
QMenuBar::item { padding: 4px 8px; background: transparent; }
QMenu { border: 1px solid; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 24px; border-radius: 2px; }
QMenu::separator { height: 1px; margin: 4px 6px; }
QLineEdit, QComboBox, QAbstractSpinBox { border: 1px solid; border-radius: 4px; min-height: 22px; padding: 1px 6px; }
QComboBox { padding-right: 20px; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { width: 10px; height: 6px; }
QComboBox QLineEdit { border: none; border-radius: 0; min-height: 0; padding: 0; background: transparent; }
QComboBox QAbstractItemView { max-height: 264px; border: 1px solid; padding: 2px; outline: none; }
QAbstractSpinBox { padding-right: 18px; }
QAbstractSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 18px; border: none; }
QAbstractSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 18px; border: none; }
QAbstractSpinBox::up-arrow, QAbstractSpinBox::down-arrow { width: 8px; height: 5px; }
QCheckBox { spacing: 6px; }
QHeaderView::section { border: none; border-bottom: 1px solid; padding: 5px 6px; font-weight: normal; }
QHeaderView::up-arrow, QHeaderView::down-arrow { width: 10px; height: 6px; }
QTableView, QTreeView, QListView { border: none; outline: none; }
QTableView::item, QTreeView::item { padding: 0 5px; border: 1px solid transparent; }
QSplitter::handle { border: none; }
QSplitter::handle:vertical { height: 4px; }
QSplitter::handle:horizontal { width: 4px; }
QFrame#Pane, QFrame#TerminalPanel { border: none; }
QFrame#PaneHeader, QFrame#TerminalToolbar { border: none; }
QLabel#PaneBadge { border-radius: 2px; padding: 2px 5px; }
QLabel#DialogHeading, QLabel#PaneTitle, QLabel#TerminalTitle { font-weight: @strong-weight@; }
QLabel#PathBreadcrumbs { border: 1px solid; border-radius: 3px; }
QWidget#PaneFooterBar { border-top: 1px solid; }
QLineEdit#FilterEdit { min-height: 20px; padding: 1px 5px; }
QLabel#WelcomeTitle { font-size: 12pt; font-weight: @strong-weight@; }
QTabWidget::pane { border: none; }
QTabBar::tab { border: none; border-bottom: 2px solid transparent; padding: 4px 9px; margin-right: 2px; }
QTabBar::close-button { width: 12px; height: 12px; border-radius: 2px; padding: 2px; }
QTabBar#SessionTabs { qproperty-drawBase: 0; }
QStatusBar { border-top: 1px solid; min-height: 22px; }
QStatusBar::item { border: none; }
QDockWidget::title { padding: 4px 6px; }
QListWidget#LoginSites { border: 1px solid; border-radius: 4px; padding: 4px; }
QListWidget#LoginSites::item { padding: 8px; border-radius: 3px; }
QGroupBox { border: 1px solid; border-radius: 4px; margin-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; font-weight: @strong-weight@; }
QLabel#LoginHeading { font-size: 14pt; font-weight: @strong-weight@; }
QLabel#LoginSitesHeading { font-weight: @strong-weight@; padding: 2px 0; }
QFrame#LoginFooter { border: none; border-top: 1px solid; }
QProgressBar { border: none; border-radius: 2px; text-align: center; }
QProgressBar::chunk { border-radius: 2px; }
QToolTip { border: 1px solid; padding: 5px 7px; }
QTableView#TransferTable, QPlainTextEdit { border: 1px solid; }

QToolBar, QMenuBar, QStatusBar, QDockWidget::title { background: @window@; border-color: @border@; }
QToolBar::separator, QMenu::separator { background: @border@; }
QToolButton { color: @text@; background: transparent; }
QToolButton:hover, QMenuBar::item:selected { background: @hover@; }
QToolButton:pressed, QToolButton:checked { background: @pressed@; }
QToolButton:focus { border-color: @focus@; }
QToolButton:disabled { background: transparent; border-color: transparent; color: @disabled@; }
QPushButton { background: @base@; color: @text@; border-color: @border@; }
QPushButton:hover { background: @surface@; border-color: @focus@; }
QPushButton:pressed, QPushButton:checked { background: @pressed@; border-color: @focus@; }
QPushButton:default, QPushButton:focus { border-color: @focus@; }
QPushButton:disabled { color: @disabled@; background: @window@; border-color: @border@; }
QPushButton[accent="true"]:enabled { background: @primary@; border-color: @primary@; color: @primary-text@; }
QPushButton[accent="true"]:hover { background: @primary-hover@; border-color: @primary-hover@; }
QPushButton[accent="true"]:pressed { background: @primary-pressed@; border-color: @primary-pressed@; }
QPushButton[accent="true"]:focus { border-color: @focus@; }
QMenu { background: @base@; border-color: @border@; color: @text@; }
QMenu::item:selected { background: @hover@; }
QMenu::item:disabled { color: @disabled@; }
QLineEdit, QComboBox, QAbstractSpinBox { background: @base@; color: @text@; border-color: @border@; selection-background-color: @selection@; selection-color: @selection-text@; }
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: @focus@; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: @focus@; }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { color: @disabled@; background: @window@; border-color: @border@; }
QComboBox QAbstractItemView { background: @base@; color: @text@; border-color: @border@; selection-background-color: @hover@; selection-color: @text@; }
QComboBox::down-arrow, QAbstractSpinBox::down-arrow, QHeaderView::down-arrow { image: url(:/icons/arrow-down-@theme@.svg); }
QAbstractSpinBox::up-arrow, QHeaderView::up-arrow { image: url(:/icons/arrow-up-@theme@.svg); }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: @hover@; }
QHeaderView::section { background: @window@; color: @muted@; border-color: @border@; }
QHeaderView::section:hover { background: @hover@; }
QTableView, QTreeView, QListView { background: @base@; color: @text@; selection-background-color: @selection@; selection-color: @selection-text@; }
QTableView::item:hover, QTreeView::item:hover { background: @surface@; }
QTableView::item:selected, QTreeView::item:selected { background: @selection@; color: @selection-text@; }
QTableView::item:selected:!active, QTreeView::item:selected:!active { background: @inactive@; color: @text@; }
QTableView::item:focus, QTreeView::item:focus { border-color: @focus@; }
QSplitter::handle { background: @border@; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: @focus@; }
QFrame#Pane, QFrame#TerminalPanel { background: @base@; }
QFrame#PaneHeader, QFrame#TerminalToolbar { background: @surface@; }
QFrame#Pane[active="true"] QFrame#PaneHeader { background: @active-header@; }
QLabel#PaneBadge { background: @hover@; color: @muted@; }
QLabel#PaneTitle, QLabel#TerminalTitle { color: @text@; }
QLabel#PaneFooter, QLabel#TerminalHint, QLabel#WelcomeText, QLabel#EmptyState, QLabel[secondary="true"] { color: @muted@; }
QLabel#PathBreadcrumbs { background: @base@; border-color: @border@; }
QLabel#PathBreadcrumbs:hover, QLabel#PathBreadcrumbs:focus { border-color: @focus@; }
QWidget#PaneFooterBar { background: @surface@; border-color: @border@; }
QWidget#WelcomePage { background: @base@; }
QTabBar { background: @window@; }
QTabBar::tab { background: @window@; color: @muted@; }
QTabBar::tab:hover { background: @hover@; color: @text@; }
QTabBar::tab:selected { background: @base@; color: @text@; border-bottom-color: @accent@; }
QTabBar::close-button { image: url(:/icons/close-@theme@.svg); }
QTabBar::close-button:hover { background: @pressed@; }
QWidget#TerminalView { background: @terminal@; }
QListWidget#LoginSites { border-color: @border@; background: @base@; }
QListWidget#LoginSites::item:hover { background: @surface@; }
QListWidget#LoginSites::item:selected { background: @selection@; color: @selection-text@; }
QGroupBox, QFrame#LoginFooter { border-color: @border@; }
QGroupBox::title { color: @muted@; }
QProgressBar { background: @hover@; }
QProgressBar::chunk { background: @accent@; }
QTableView#TransferTable, QPlainTextEdit { border-color: @border@; }
QPlainTextEdit:focus { border-color: @focus@; }
QToolTip { background: @base@; color: @text@; border-color: @border@; }
