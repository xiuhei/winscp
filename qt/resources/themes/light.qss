QToolBar {
    border: none;
    border-bottom: 1px solid #a0a0a0;
    spacing: 1px;
    padding: 1px 2px;
}
QToolBar::separator { width: 1px; background: #b0b0b0; margin: 2px 3px; }
QToolButton { padding: 1px; }
QMenuBar::item { padding: 2px 6px; }
QMenu::item { padding: 3px 24px 3px 22px; }
QLineEdit { padding: 1px 3px; }
QComboBox { min-height: 20px; }
QComboBox QLineEdit { padding: 0; }
QHeaderView::section { padding: 2px 4px; font-weight: normal; }
QTableView, QTreeView, QListView { border: none; }
QTableView::item, QTreeView::item { padding: 0 3px; }
QSplitter::handle { background: #d0d0d0; }
QSplitter::handle:vertical { height: 3px; }
QSplitter::handle:horizontal { width: 3px; }
QFrame#Pane, QFrame#TerminalPanel {
    background: #ffffff;
    border: 1px solid #a0a0a0;
}
QFrame#Pane[active="true"] { border-color: #5a85b5; }
QFrame#PaneHeader, QFrame#TerminalToolbar {
    background: #f0f0f0;
    border: none;
    border-bottom: 1px solid #c0c0c0;
}
QLabel#PaneBadge { color: #505050; padding: 0 2px; }
QLabel#PaneTitle { color: #000000; }
QLabel#PaneFooter, QLabel#TerminalHint { color: #606060; }
QFrame#PaneFooterLine { background: #c0c0c0; max-height: 1px; border: none; }
QLineEdit#FilterEdit { padding: 0 2px; }
QWidget#WelcomePage { background: #ffffff; }
QLabel#WelcomeTitle { font-size: 10pt; font-weight: bold; }
QLabel#WelcomeText { color: #606060; }
QTabWidget::pane { border: none; }
QTabBar::tab {
    background: #f0f0f0;
    border: 1px solid #b0b0b0;
    padding: 2px 7px;
    margin-right: 1px;
}
QTabBar::tab:selected { background: #ffffff; border-bottom-color: #ffffff; }
QWidget#TerminalView { background: #000000; }
QStatusBar { background: #f0f0f0; border-top: 1px solid #b0b0b0; }
QStatusBar::item { border: none; }
QDockWidget::title { background: #f0f0f0; padding: 2px 4px; }
