QToolBar {
    background: #232830;
    border: none;
    border-bottom: 1px solid #424a55;
    spacing: 1px;
    padding: 1px 2px;
}
QToolBar::separator { width: 1px; background: #424a55; margin: 2px 3px; }
QToolButton { padding: 1px; }
QMenuBar::item { padding: 2px 6px; }
QMenu::item { padding: 3px 24px 3px 22px; }
QLineEdit { padding: 1px 3px; }
QComboBox { min-height: 20px; }
QComboBox QLineEdit { padding: 0; }
QHeaderView::section { padding: 2px 4px; font-weight: normal; }
QTableView, QTreeView, QListView { border: none; }
QTableView::item, QTreeView::item { padding: 0 3px; }
QSplitter::handle { background: #424a55; }
QSplitter::handle:vertical { height: 3px; }
QSplitter::handle:horizontal { width: 3px; }
QFrame#Pane, QFrame#TerminalPanel {
    background: #1b212b;
    border: 1px solid #424a55;
}
QFrame#Pane[active="true"] { border-color: #7594b5; }
QFrame#PaneHeader, QFrame#TerminalToolbar {
    background: #232830;
    border: none;
    border-bottom: 1px solid #424a55;
}
QLabel#PaneBadge { color: #aab4c0; padding: 0 2px; }
QLabel#PaneTitle { color: #d7deea; }
QLabel#PaneFooter, QLabel#TerminalHint { color: #aab4c0; }
QFrame#PaneFooterLine { background: #424a55; max-height: 1px; border: none; }
QLineEdit#FilterEdit { padding: 0 2px; }
QWidget#WelcomePage { background: #1b212b; }
QLabel#WelcomeTitle { font-size: 10pt; font-weight: bold; }
QLabel#WelcomeText { color: #aab4c0; }
QTabWidget::pane { border: none; }
QTabBar::tab {
    background: #232830;
    border: 1px solid #424a55;
    padding: 2px 7px;
    margin-right: 1px;
}
QTabBar::tab:selected { background: #1b212b; border-bottom-color: #1b212b; }
QWidget#TerminalView { background: #000000; }
QStatusBar { background: #232830; border-top: 1px solid #424a55; }
QStatusBar::item { border: none; }
QDockWidget::title { background: #232830; padding: 2px 4px; }
