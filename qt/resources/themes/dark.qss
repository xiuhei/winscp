QToolBar, QMenuBar, QStatusBar, QDockWidget::title { background: #2b2b2b; border-color: #454545; }
QToolBar::separator, QMenu::separator { background: #454545; }
QToolButton { color: #dedede; background: transparent; }
QToolButton:hover, QMenuBar::item:selected { background: #3a3a3a; }
QToolButton:pressed, QToolButton:checked { background: #484848; border-color: #686868; }
QToolButton:focus { border-color: #a0a0a0; }
QToolButton:disabled { background: transparent; border-color: transparent; color: #858585; }
QPushButton { background: #353535; color: #dedede; border-color: #606060; }
QPushButton:hover { background: #414141; border-color: #858585; }
QPushButton:pressed, QPushButton:checked { background: #4b4b4b; border-color: #a0a0a0; }
QPushButton:default, QPushButton:focus { border-color: #b6b6b6; }
QPushButton:disabled { color: #858585; background: #2b2b2b; border-color: #454545; }
QPushButton#LoginButton { background: #dedede; border-color: #dedede; color: #202020; }
QPushButton#LoginButton:hover { background: #f0f0f0; border-color: #f0f0f0; }
QPushButton#LoginButton:pressed { background: #b6b6b6; border-color: #b6b6b6; }
QMenu { background: #2b2b2b; border-color: #606060; color: #dedede; }
QMenu::item:selected { background: #454545; }
QMenu::item:disabled { color: #858585; }
QLineEdit, QComboBox, QAbstractSpinBox { background: #202020; color: #dedede; border-color: #555555; selection-background-color: #555555; selection-color: #ffffff; }
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: #777777; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: #a0a0a0; }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { color: #858585; background: #2b2b2b; border-color: #454545; }
QComboBox QAbstractItemView { background: #2b2b2b; color: #dedede; border-color: #606060; selection-background-color: #484848; selection-color: #ffffff; }
QComboBox::down-arrow, QAbstractSpinBox::down-arrow, QHeaderView::down-arrow { image: url(:/icons/arrow-down-dark.svg); }
QAbstractSpinBox::up-arrow, QHeaderView::up-arrow { image: url(:/icons/arrow-up-dark.svg); }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: #414141; }
QHeaderView::section { background: #2b2b2b; color: #b6b6b6; border-color: #454545; }
QHeaderView::section:hover { background: #383838; }
QTableView, QTreeView, QListView { background: #202020; color: #dedede; selection-background-color: #4a4a4a; selection-color: #ffffff; }
QTableView::item:hover, QTreeView::item:hover { background: #303030; }
QTableView::item:selected, QTreeView::item:selected { background: #4a4a4a; color: #ffffff; }
QTableView::item:selected:!active, QTreeView::item:selected:!active { background: #363636; color: #c8c8c8; }
QSplitter::handle { background: #383838; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: #777777; }
QFrame#Pane, QFrame#TerminalPanel { background: #202020; border-color: #454545; }
QFrame#Pane[active="true"] { border-color: #909090; }
QFrame#PaneHeader, QFrame#TerminalToolbar { background: #2b2b2b; border-color: #454545; }
QFrame#Pane[active="true"] QFrame#PaneHeader { background: #333333; }
QLabel#PaneBadge { background: #414141; color: #c8c8c8; }
QLabel#PaneTitle, QLabel#TerminalTitle { color: #dedede; }
QLabel#PaneFooter, QLabel#TerminalHint, QLabel#WelcomeText, QLabel#LoginDescription { color: #b6b6b6; }
QLabel#PathBreadcrumbs { background: #202020; border-color: #555555; }
QLabel#PathBreadcrumbs:hover { border-color: #777777; }
QFrame#PaneFooterLine { background: #454545; }
QWidget#WelcomePage { background: #202020; }
QTabBar { background: #292929; }
QTabBar::tab { background: #292929; color: #b6b6b6; }
QTabBar::tab:hover { background: #3a3a3a; color: #dedede; }
QTabBar::tab:selected { background: #202020; color: #ffffff; border-bottom-color: #b6b6b6; }
QTabBar::close-button { image: url(:/icons/close-dark.svg); }
QTabBar::close-button:hover { background: #555555; }
QWidget#TerminalView { background: #000000; }
QListWidget#LoginSites { border-color: #555555; background: #202020; }
QListWidget#LoginSites::item:hover { background: #303030; }
QListWidget#LoginSites::item:selected { background: #4a4a4a; color: #ffffff; }
QGroupBox, QFrame#LoginFooter { border-color: #555555; }
QGroupBox::title { color: #c8c8c8; }
QProgressBar { background: #383838; }
QProgressBar::chunk { background: #b6b6b6; }
QToolTip { background: #333333; color: #eeeeee; border-color: #606060; }
