/* WinSCP Qt - dark theme */
QWidget {
    color: #d7deea;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei";
    font-size: 10pt;
    selection-background-color: #385a82;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #171b22;
}

QMenuBar {
    background-color: #1c212a;
    color: #c9d3e0;
    border-bottom: 1px solid #2b3441;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #2a3442;
    color: #ffffff;
}
QMenuBar::item:pressed {
    background: #344154;
}

QMenu {
    background-color: #232a35;
    border: 1px solid #3a4555;
    border-radius: 6px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 30px 6px 28px;
    border-radius: 4px;
    color: #d7deea;
}
QMenu::item:selected {
    background-color: #315277;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #6c7788;
}
QMenu::separator {
    height: 1px;
    background: #343f4e;
    margin: 5px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

QToolBar {
    background-color: #1c222b;
    border: none;
    border-bottom: 1px solid #2b3441;
    spacing: 3px;
    padding: 5px 8px;
}
QToolBar::separator {
    width: 1px;
    background: #333e4d;
    margin: 4px 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px;
    color: #cfd8e6;
}
QToolButton:hover {
    background: #2a3442;
    border-color: #3b4a5e;
}
QToolButton:pressed, QToolButton:checked {
    background: #34465c;
    border-color: #4b6380;
}
QToolButton:disabled {
    color: #5f6b7c;
}

QPushButton {
    background: #2a3341;
    border: 1px solid #3c4a5c;
    border-radius: 5px;
    padding: 5px 16px;
    min-height: 20px;
    color: #dbe3ee;
}
QPushButton:hover {
    background: #334052;
    border-color: #50647e;
}
QPushButton:pressed {
    background: #243040;
}
QPushButton:disabled {
    background: #232a34;
    color: #667181;
    border-color: #303a47;
}
QPushButton[accent="true"] {
    background: #e0821c;
    border-color: #f19a34;
    color: #ffffff;
    font-weight: 600;
}
QPushButton[accent="true"]:hover {
    background: #f0922a;
    border-color: #ffb04d;
}
QPushButton[accent="true"]:pressed {
    background: #c97214;
}
QPushButton[flat="true"] {
    background: transparent;
    border-color: transparent;
    color: #9fb0c6;
    padding: 4px 10px;
}
QPushButton[flat="true"]:hover {
    background: #2a3442;
    color: #ffffff;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    background: #11161d;
    border: 1px solid #394556;
    border-radius: 5px;
    padding: 5px 8px;
    color: #dce4ef;
}
QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border-color: #4a5a70;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus,
QComboBox:focus, QDateTimeEdit:focus {
    border-color: #e0821c;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: #1a2029;
    color: #606b7b;
}
QComboBox {
    background: #11161d;
    border: 1px solid #394556;
    border-radius: 5px;
    padding: 5px 8px;
    color: #dce4ef;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8fa0b5;
    width: 0;
    height: 0;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background: #232a35;
    border: 1px solid #3a4555;
    selection-background-color: #315277;
    padding: 4px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #d7deea;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4a586b;
    background: #11161d;
}
QCheckBox::indicator {
    border-radius: 3px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #e0821c;
    border-color: #f19a34;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #1d242d;
    border-color: #333d4a;
}

QGroupBox {
    border: 1px solid #303b49;
    border-radius: 7px;
    margin-top: 18px;
    padding: 12px 10px 8px 10px;
    font-weight: 600;
    color: #aab8ca;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #8fa2b8;
}

QTableView, QTreeView, QListView {
    background-color: #1b212b;
    alternate-background-color: #1f2631;
    border: 1px solid #2e3948;
    border-radius: 4px;
    gridline-color: #2c3543;
    selection-background-color: #355777;
    selection-color: #ffffff;
    outline: none;
}
QTableView::item, QTreeView::item {
    padding: 1px 6px;
    border: none;
}
QTableView::item:selected, QTreeView::item:selected {
    background: #355777;
    color: #ffffff;
}
QTableView::item:hover, QTreeView::item:hover {
    background: #263241;
}
QHeaderView::section {
    background-color: #232b36;
    color: #8fa0b5;
    border: none;
    border-right: 1px solid #2f3947;
    border-bottom: 1px solid #303b49;
    padding: 6px 8px;
    font-weight: 600;
}
QHeaderView::section:hover {
    background: #2a3442;
    color: #c4d0df;
}
QTableCornerButton::section {
    background: #232b36;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3d4a5c;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #52637a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3d4a5c;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #52637a;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background: #2b3441;
}
QSplitter::handle:hover {
    background: #e0821c;
}
QSplitter::handle:vertical {
    height: 4px;
}
QSplitter::handle:horizontal {
    width: 4px;
}

QStatusBar {
    background: #1c222b;
    border-top: 1px solid #2b3441;
    color: #8fa0b5;
}
QStatusBar::item {
    border: none;
}

QTabWidget::pane {
    border: none;
    background: #171b22;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #8291a6;
    border: none;
    padding: 7px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:hover {
    background: #232b36;
    color: #c4d0df;
}
QTabBar::tab:selected {
    background: #1f2631;
    color: #f0a040;
    border-bottom: 2px solid #e0821c;
}

QProgressBar {
    background: #151a21;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: #e0821c;
    border-radius: 3px;
}

QFrame#Pane {
    background: #1a1f27;
    border: 1px solid #2d3745;
    border-radius: 8px;
}
QFrame#Pane[active="true"] {
    border-color: #4b5f78;
}
QFrame#PaneHeader {
    background: #1e242e;
    border: none;
    border-bottom: 1px solid #2d3745;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QLabel#PaneTitle {
    color: #e7edf6;
    font-weight: 600;
    font-size: 10pt;
}
QLabel#PaneSubtitle {
    color: #7f8da2;
    font-size: 9pt;
}
QLabel#PaneBadge {
    background: #2b394b;
    color: #8fc7ff;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8.5pt;
    font-weight: 600;
}
QLabel#PaneBadge[role="remote"] {
    background: #3a2c19;
    color: #f1a64b;
}
QLabel#PaneFooter {
    color: #7f8da2;
    font-size: 9pt;
}
QLabel#PaneStatus {
    color: #aab8ca;
    font-size: 9pt;
    padding: 0 6px;
}
QFrame#PaneFooterLine {
    background: #27303c;
    max-height: 1px;
    border: none;
}
QLineEdit#FilterEdit {
    background: transparent;
    border: 1px solid #303b49;
    padding: 3px 7px;
    border-radius: 4px;
    color: #c4d0df;
}

QWidget#WelcomePage {
    background: #1a1f27;
}
QLabel#WelcomeTitle {
    color: #dbe3ee;
    font-size: 15pt;
    font-weight: 600;
}
QLabel#WelcomeText {
    color: #8492a6;
    font-size: 10pt;
}

QFrame#TerminalPanel {
    background: #10141a;
    border: 1px solid #2d3745;
    border-radius: 8px;
}
QFrame#TerminalToolbar {
    background: #1b212a;
    border: none;
    border-bottom: 1px solid #2a3340;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QLabel#TerminalTitle {
    color: #9fb0c6;
    font-weight: 600;
}
QLabel#TerminalHint {
    color: #6e7c90;
    font-size: 9pt;
}
QTabWidget#TerminalTabs::pane {
    border: none;
    background: #0e1116;
}

QWidget#TerminalView {
    background: #0e1116;
}

QToolTip {
    background-color: #2b3441;
    color: #e7edf6;
    border: 1px solid #46556a;
    border-radius: 4px;
    padding: 4px 8px;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QListWidget {
    background: #1b212b;
    border: 1px solid #2e3948;
    border-radius: 5px;
    padding: 4px;
}
QListWidget::item {
    padding: 7px 9px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background: #355777;
    color: #ffffff;
}

QMessageBox {
    background-color: #1c222b;
}


QDockWidget {
    background: #1a1f27;
    color: #d7deea;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #1e242e;
    border-bottom: 1px solid #2d3745;
    padding: 6px 10px;
    text-align: left;
    font-weight: 600;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #2a3442;
    border-radius: 3px;
}

